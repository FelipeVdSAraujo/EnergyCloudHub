# Core server
PORT=4000
FRONTEND_URL=https://YOUR_DOMAIN
MONGO_URL=mongodb://mongo:27017/empire_runs
JWT_SECRET=REPLACE_WITH_STRONG_SECRET

# Repository/runtime paths inside container
ENSOLVE_ROOT=/workspace

# Admin bootstrap
ADMIN_EMAILS=
ADMIN_USERNAMES=
ADMIN_APPROVAL_EMAIL=

# Email (new deployment)
# For Brevo SMTP, keep EMAIL_HOST/EMAIL_PORT and use EMAIL_USER + EMAIL_SMTP.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_SMTP=
EMAIL_FROM=

# Optional fallback path if you use provider alias instead of SMTP host
EMAIL_SERVICE=
EMAIL_PASSWORD=

# Optional runtime overrides
JULIA_EXE=julia

# Phase 3 remote orchestration
REMOTE_RUNNER_ENABLED=true
REMOTE_RUNNER_HOST=REMOTE_HOST.example.com
REMOTE_RUNNER_USER=runner
REMOTE_RUNNER_SSH_OPTIONS=
REMOTE_RESULTS_ROOT=C:\\model-results

