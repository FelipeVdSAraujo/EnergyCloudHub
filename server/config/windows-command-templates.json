{
  "empire": "powershell -NoProfile -ExecutionPolicy Bypass -File C:/EnSolveCloud/website_clone/scripts/run_empire_remote.ps1 -RunName \"{RUN_NAME}\" -DatasetName \"{DATASET_NAME}\" -OutputDir \"{REMOTE_RESULTS_ROOT}/{RUN_ID}\"",
  "emx": "powershell -NoProfile -ExecutionPolicy Bypass -File C:/EnSolveCloud/website_clone/scripts/run_emx_remote.ps1 -RunName \"{RUN_NAME}\" -OutputDir \"{REMOTE_RESULTS_ROOT}/{RUN_ID}\" -CaseType \"{CASE_TYPE}\" -OpPeriods \"{OP_PERIODS}\" -OpPeriodsDuration \"{OP_PERIODS_DURATION}\" -OptimHor \"{OPTIM_HOR}\" -ImplHor \"{IMPL_HOR}\" -IncludeLithiumIon \"{INCLUDE_LITHIUM_ION}\" -IncludePumpedStorage \"{INCLUDE_PUMPED_STORAGE}\" -IncludeHydroReservoir \"{INCLUDE_HYDRO_RESERVOIR}\" -GenerateDispatchPlot \"{GENERATE_DISPATCH_PLOT}\" -RunMode \"{RUN_MODE}\" -EmissionPrice \"{EMISSION_PRICE}\" -OpexElectricitySolarPvUtilityOptimal \"{OPEX_ELECTRICITY_SOLAR_PV_UTILITY_OPTIMAL}\" -OpexElectricityWindOnshoreAverage \"{OPEX_ELECTRICITY_WIND_ONSHORE_AVERAGE}\" -OpexElectricityWindOffshoreTransitional \"{OPEX_ELECTRICITY_WIND_OFFSHORE_TRANSITIONAL}\" -OpexElectricityHydroRunOfRiver \"{OPEX_ELECTRICITY_HYDRO_RUN_OF_RIVER}\" -OpexHeatSolar \"{OPEX_HEAT_SOLAR}\" -SelectedCountries \"{SELECTED_COUNTRIES}\" -SelectedOutputVariables \"{SELECTED_OUTPUT_VARIABLES}\" -ModelName \"EnergyModelsX v0.10\"",
  "transcomp": "powershell -NoProfile -ExecutionPolicy Bypass -File C:/EnSolveCloud/website_clone/scripts/run_transcomp_remote.ps1 -RunName \"{RUN_NAME}\" -InputDir \"{INPUT_DIR}\" -OutputDir \"{REMOTE_RESULTS_ROOT}/{RUN_ID}\" -ConfigPath \"{CONFIG_PATH}\"",
  "gcam": "powershell -NoProfile -ExecutionPolicy Bypass -File C:/EnSolveCloud/website_clone/scripts/run_gcam_remote.ps1 -RunName \"{RUN_NAME}\" -OutputDir \"{REMOTE_RESULTS_ROOT}/{RUN_ID}\" -GcamHome \"{GCAM_HOME}\" -ConfigurationFile \"{CONFIGURATION_FILE}\" -ScenarioName \"{SCENARIO_NAME}\" -UseBatchMode \"{USE_BATCH_MODE}\" -BatchFileName \"{BATCH_FILE_NAME}\" -StopPeriod \"{STOP_PERIOD}\"",
  "ukraine": "powershell -NoProfile -ExecutionPolicy Bypass -File C:/EnSolveCloud/website_clone/scripts/run_ukraine_remote.ps1 -RunName \"{RUN_NAME}\" -ConfigPath \"{CONFIG_PATH}\" -Start \"{WINDOW_START}\" -End \"{WINDOW_END}\" -OutputDir \"{REMOTE_RESULTS_ROOT}/{RUN_ID}\""
}
